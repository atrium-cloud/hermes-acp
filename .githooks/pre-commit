#!/usr/bin/env bash
#
# Runs the checks from .github/workflows/ci.yml so a red tree never lands.
# Packaging the release zip is left to CI and the release workflow.
# Installed by `bun install` (the `prepare` script sets core.hooksPath=.githooks).
# Bypass for a work-in-progress commit with `git commit --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

bun run typecheck
bun run test
bun run build
node dist/index.js --version
